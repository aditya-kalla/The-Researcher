# Vertex AI / Gemini access — uses your Google Cloud credits
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Same Firebase Admin credentials researcher-backend/server.js already uses
# — copy these straight from researcher-backend/.env, do not create new ones
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=the-researcher-ef159

PORT=8080
